      "transcript": "ਸਰਬ ਕਲਾ ਭਰਪੂਰੁ, ਦਿਸੈ ਜਤ ਕਤਾ,",
      "start_time": 3894.486,
      "end_time": 3898.338
    },
    {
      "section_id": "section-255",
      "transcript": "ਨਾਨਕ ਦਾਸਨਿ ਦਾਸੁ, ਤੁਧੁ ਆਗੈ ਬਿਨਵਤਾ,",
      "start_time": 3898.6,
      "end_time": 3903.804
    },
    {
      "section_id": "section-256",
      "transcript": "ਸਲੋਕ, ਪਵਣੁ ਗੁਰੂ ਪਾਣੀ ਪਿਤਾ, ਮਾਤਾ,",
      "start_time": 3903.805,
      "end_time": 3908.915
    },
    {
      "section_id": "section-257",
      "transcript": "ਦਿਨਸੁ ਰਾਤਿ ਦੁਇ ਦਾਈ ਦਾਇਆ, ਖੇਲੈ ਸਗਲ ਜਗਤੁ,",
      "start_time": 3908.916,
      "end_time": 3914.318
    },
    {
      "section_id": "section-258",
      "transcript": "ਚੰਗਿਆਈਆ ਬੁਰਿਆਈਆ, ਵਾਚੇ ਧਰਮੁ ਹਦੂਰਿ,",
      "start_time": 3914.319,
      "end_time": 3920.105
    },
    {
      "section_id": "section-259",
      "transcript": "ਕਰਮੀ ਆਪੋ ਆਪਣੀ, ਕੇ ਨੇੜੈ ਕੇ ਦੂਰਿ,",
      "start_time": 3920.106,
      "end_time": 3926.072
    },
    {
      "section_id": "section-260",
      "transcript": "ਜਿਨੀ ਨਾਮੁ ਧਿਆਇਆ, ਗਏ ਮਸਕਤਿ ਘਾਲਿ,",
      "start_time": 3926.073,
      "end_time": 3932.099
    },
    {
      "section_id": "section-261",
      "transcript": "ਨਾਨਕ ਤੇ ਮੁਖ ਉਜਲੇ,",
      "start_time": 3932.1,
      "end_time": 3935.376
    },
    {
      "section_id": "section-262",
      "transcript": "ਕੇਤੀ ਛੁਟੀ ਨਾਲਿ,",
      "start_time": 3935.377,
      "end_time": 3938.457
    },
    {
      "section_id": "section-263",
      "transcript": "ਜਿਨੀ ਨਾਮੁ ਧਿਆਇਆ, ਗਏ ਮਸਕਤਿ ਘਾਲਿ,",
      "start_time": 3938.458,
      "end_time": 3944.837
    },
    {
      "section_id": "section-264",
      "transcript": "ਨਾਨਕ ਤੇ ਮੁਖ ਉਜਲੇ, ਕੇਤੀ ਛੁਟੀ ਨਾਲਿ,",
      "start_time": 3944.838,
      "end_time": 3952.626
    },
    {
      "section_id": "section-265",
      "transcript": "ਵਾਹਿਗੁਰੂ ਜੀ ਕਾ ਖਾਲਸਾ, ਵਾਹਿਗੁਰੂ ਜੀ ਕੀ ਫਤਹਿ।",
      "start_time": 3952.627,
      "end_time": 3959.057
    }
  ]
}
